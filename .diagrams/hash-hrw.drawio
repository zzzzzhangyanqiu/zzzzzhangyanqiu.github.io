<mxfile host="app.diagrams.net">
  <diagram id="hashhrw" name="Rendezvous打分">
    <mxGraphModel dx="740" dy="560" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="740" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="Rendezvous：key 对每个节点各打一分，谁高归谁" style="text;html=1;align=center;verticalAlign=middle;fontSize=17;fontStyle=1;fontColor=#000000;" vertex="1" parent="1">
          <mxGeometry x="90" y="10" width="560" height="28" as="geometry" />
        </mxCell>
        <mxCell id="formula" value="家 = argmaxᵢ  hash(key, 节点ᵢ)　（遍历所有节点 i）" style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontStyle=2;fontColor=#444444;" vertex="1" parent="1">
          <mxGeometry x="120" y="44" width="500" height="24" as="geometry" />
        </mxCell>

        <!-- key -->
        <mxCell id="key" value="key = X" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#F4A7B9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="70" y="248" width="120" height="64" as="geometry" />
        </mxCell>

        <!-- nodes -->
        <mxCell id="nA" value="A　·　0.62" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#9DC3F7;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="90" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nB" value="B　·　0.91" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#FFE082;strokeColor=#E65100;strokeWidth=3;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="170" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nC" value="C　·　0.45" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#9DC3F7;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="250" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nD" value="D　·　0.78" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#9DC3F7;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="330" width="140" height="50" as="geometry" />
        </mxCell>
        <mxCell id="nE" value="E（新）　·　0.88" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#97D077;strokeColor=#000000;fontColor=#000000;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="470" y="410" width="140" height="50" as="geometry" />
        </mxCell>

        <!-- winner marker -->
        <mxCell id="win" value="← 最高分 = key 的家" style="text;html=1;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#E65100;" vertex="1" parent="1">
          <mxGeometry x="624" y="183" width="200" height="24" as="geometry" />
        </mxCell>
        <mxCell id="enote" value="← 0.88 &lt; 0.91，没夺冠，key 不迁移" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#2E7D32;" vertex="1" parent="1">
          <mxGeometry x="624" y="423" width="260" height="24" as="geometry" />
        </mxCell>

        <!-- edges -->
        <mxCell id="eA" value="" style="sketch=1;jiggle=2;curveFitting=1;endArrow=none;strokeColor=#9AA0A6;strokeWidth=1.5;" edge="1" parent="1" source="key" target="nA">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eB" value="" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;strokeColor=#E65100;strokeWidth=3.5;" edge="1" parent="1" source="key" target="nB">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eC" value="" style="sketch=1;jiggle=2;curveFitting=1;endArrow=none;strokeColor=#9AA0A6;strokeWidth=1.5;" edge="1" parent="1" source="key" target="nC">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eD" value="" style="sketch=1;jiggle=2;curveFitting=1;endArrow=none;strokeColor=#9AA0A6;strokeWidth=1.5;" edge="1" parent="1" source="key" target="nD">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="eE" value="" style="sketch=1;jiggle=2;curveFitting=1;endArrow=none;strokeColor=#2E7D32;strokeWidth=1.5;dashed=1;" edge="1" parent="1" source="key" target="nE">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="foot" value="加入 E 只是多算一个分数：只有当 E 成为新的最高分时，key 才改投 E，其余 key 归属不变 —— 迁移最优，且天生均匀。" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="40" y="510" width="660" height="34" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
