<mxfile host="app.diagrams.net">
  <diagram id="notify-then-pull" name="notify-then-pull">
    <mxGraphModel dx="900" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="480" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="title" value="notify-then-pull ｜ 通知走 push 抢延迟，搬运走 pull 保背压" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#000000" vertex="1" parent="1">
          <mxGeometry x="30" y="20" width="820" height="34" as="geometry" />
        </mxCell>

        <!-- ============ 卡片1 Webhook ============ -->
        <mxCell id="c1" value="Webhook" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1;fontSize=15;arcSize=4;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="30" y="80" width="260" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c1up" value="GitHub" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#F4A7B9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="65" y="135" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1dn" value="CI" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#FFD45E;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="155" y="310" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c1push" value="① webhook：有新提交" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#C92A2A;strokeWidth=2.5;fontColor=#C92A2A;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="c1up" target="c1dn">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-2" y="-20" /></mxGeometry>
        </mxCell>
        <mxCell id="c1pull" value="② git clone / 拉 diff" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#1864AB;strokeWidth=2.5;fontColor=#1864AB;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="c1dn" target="c1up">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="2" y="20" /></mxGeometry>
        </mxCell>

        <!-- ============ 卡片2 数据库 CDC ============ -->
        <mxCell id="c2" value="数据库 CDC" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1;fontSize=15;arcSize=4;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="320" y="80" width="260" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c2up" value="binlog" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#F4A7B9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="355" y="135" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2dn" value="Debezium" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#FFD45E;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="445" y="310" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c2push" value="① 变更信号" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#C92A2A;strokeWidth=2.5;fontColor=#C92A2A;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="c2up" target="c2dn">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-2" y="-20" /></mxGeometry>
        </mxCell>
        <mxCell id="c2pull" value="② 读取变更行" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#1864AB;strokeWidth=2.5;fontColor=#1864AB;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="c2dn" target="c2up">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="2" y="20" /></mxGeometry>
        </mxCell>

        <!-- ============ 卡片3 移动推送 ============ -->
        <mxCell id="c3" value="移动推送" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#FFFFFF;strokeColor=#000000;fontColor=#000000;verticalAlign=top;fontStyle=1;fontSize=15;arcSize=4;spacingTop=8" vertex="1" parent="1">
          <mxGeometry x="610" y="80" width="260" height="330" as="geometry" />
        </mxCell>
        <mxCell id="c3up" value="APNs / FCM" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#F4A7B9;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="645" y="135" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3dn" value="App" style="rounded=1;sketch=1;jiggle=2;curveFitting=1;fillStyle=solid;fillColor=#FFD45E;strokeColor=#000000;fontColor=#000000;fontStyle=1;fontSize=14" vertex="1" parent="1">
          <mxGeometry x="735" y="310" width="100" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c3push" value="① 唤醒：有新消息" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#C92A2A;strokeWidth=2.5;fontColor=#C92A2A;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.4;exitY=1;exitDx=0;exitDy=0;entryX=0.3;entryY=0;entryDx=0;entryDy=0" edge="1" parent="1" source="c3up" target="c3dn">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="-2" y="-20" /></mxGeometry>
        </mxCell>
        <mxCell id="c3pull" value="② 拉完整内容" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#1864AB;strokeWidth=2.5;fontColor=#1864AB;fontSize=12;fontStyle=1;labelBackgroundColor=#FFFFFF;exitX=0.7;exitY=0;exitDx=0;exitDy=0;entryX=0.6;entryY=1;entryDx=0;entryDy=0" edge="1" parent="1" source="c3dn" target="c3up">
          <mxGeometry relative="1" as="geometry"><mxPoint as="offset" x="2" y="20" /></mxGeometry>
        </mxCell>

        <!-- ============ 图例 ============ -->
        <mxCell id="lg-red" value="" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#C92A2A;strokeWidth=2.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="300" y="438" as="sourcePoint" /><mxPoint x="340" y="438" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg-red-t" value="① push：先推个小信号" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#C92A2A;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="346" y="426" width="170" height="24" as="geometry" />
        </mxCell>
        <mxCell id="lg-blue" value="" style="sketch=1;jiggle=2;curveFitting=1;endArrow=classic;html=1;strokeColor=#1864AB;strokeWidth=2.5" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry"><mxPoint x="540" y="438" as="sourcePoint" /><mxPoint x="580" y="438" as="targetPoint" /></mxGeometry>
        </mxCell>
        <mxCell id="lg-blue-t" value="② pull：下游再来拉数据" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#1864AB;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="586" y="426" width="190" height="24" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
