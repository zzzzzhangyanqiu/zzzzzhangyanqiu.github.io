  <diagram id="dual" name="双连续">
    <mxGraphModel dx="1120" dy="500" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1120" pageHeight="580" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ===== 标题 ===== -->
        <mxCell id="tk" value="Kafka：按「消费」维度连续" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="440" height="26" as="geometry"/></mxCell>
        <mxCell id="tks" value="每个 partition 独立成文件，同分区消息首尾相连" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="46" width="440" height="18" as="geometry"/></mxCell>
        <mxCell id="tr" value="RocketMQ：按「写入」维度连续" style="text;html=1;align=left;verticalAlign=middle;fontSize=15;fontStyle=1;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="588" y="20" width="500" height="26" as="geometry"/></mxCell>
        <mxCell id="trs" value="所有 topic/queue 挤一个 CommitLog，按写入顺序追加" style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="588" y="46" width="500" height="18" as="geometry"/></mxCell>

