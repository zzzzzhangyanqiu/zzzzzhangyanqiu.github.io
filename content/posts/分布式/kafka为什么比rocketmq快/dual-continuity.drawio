        <!-- ConsumeQueue 红 -->
        <mxCell id="qrl" value="ConsumeQueue · 红队列" style="text;html=1;align=left;fontSize=10;fontColor=#B85450;" vertex="1" parent="1"><mxGeometry x="588" y="196" width="180" height="14" as="geometry"/></mxCell>
        <mxCell id="qr0" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#FCE8E6;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="212" width="34" height="22" as="geometry"/></mxCell>
        <mxCell id="qr1" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#FCE8E6;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="628" y="212" width="34" height="22" as="geometry"/></mxCell>
        <mxCell id="qr2" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#FCE8E6;strokeColor=#B85450;fontSize=10;" vertex="1" parent="1"><mxGeometry x="666" y="212" width="34" height="22" as="geometry"/></mxCell>
        <!-- ConsumeQueue 蓝 -->
        <mxCell id="qbl" value="ConsumeQueue · 蓝队列" style="text;html=1;align=left;fontSize=10;fontColor=#6C8EBF;" vertex="1" parent="1"><mxGeometry x="588" y="252" width="180" height="14" as="geometry"/></mxCell>
        <mxCell id="qb0" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#EAF0FB;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="268" width="34" height="22" as="geometry"/></mxCell>
        <mxCell id="qb1" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#EAF0FB;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="628" y="268" width="34" height="22" as="geometry"/></mxCell>
        <mxCell id="qb2" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#EAF0FB;strokeColor=#6C8EBF;fontSize=10;" vertex="1" parent="1"><mxGeometry x="666" y="268" width="34" height="22" as="geometry"/></mxCell>
        <!-- ConsumeQueue 绿 -->
        <mxCell id="qgl" value="ConsumeQueue · 绿队列" style="text;html=1;align=left;fontSize=10;fontColor=#82B366;" vertex="1" parent="1"><mxGeometry x="588" y="308" width="180" height="14" as="geometry"/></mxCell>
        <mxCell id="qg0" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#EAF3E8;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="590" y="324" width="34" height="22" as="geometry"/></mxCell>
        <mxCell id="qg1" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#EAF3E8;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="628" y="324" width="34" height="22" as="geometry"/></mxCell>
        <mxCell id="qg2" value="→" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#EAF3E8;strokeColor=#82B366;fontSize=10;" vertex="1" parent="1"><mxGeometry x="666" y="324" width="34" height="22" as="geometry"/></mxCell>

        <!-- 散落寻址箭头：queue → commitlog 同色块 -->
        <mxCell id="ar0" style="endArrow=block;html=1;sketch=1;strokeColor=#B85450;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qr0" target="c0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ar1" style="endArrow=block;html=1;sketch=1;strokeColor=#B85450;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qr1" target="c3"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ar2" style="endArrow=block;html=1;sketch=1;strokeColor=#B85450;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qr2" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ab0" style="endArrow=block;html=1;sketch=1;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qb0" target="c1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ab1" style="endArrow=block;html=1;sketch=1;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qb1" target="c4"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ab2" style="endArrow=block;html=1;sketch=1;strokeColor=#6C8EBF;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qb2" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ag0" style="endArrow=block;html=1;sketch=1;strokeColor=#82B366;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qg0" target="c2"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ag1" style="endArrow=block;html=1;sketch=1;strokeColor=#82B366;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qg1" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="ag2" style="endArrow=block;html=1;sketch=1;strokeColor=#82B366;strokeWidth=1.5;dashed=1;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="qg2" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell>

        <mxCell id="rcap" value="一个 queue 的消息散落各处 → 先查 ConsumeQueue 拿偏移，再 mmap 逐条捞，数据过一遍用户态（多一次拷贝，用不了 sendfile）" style="text;html=1;align=left;verticalAlign=top;fontSize=11;fontColor=#444444;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="588" y="356" width="468" height="48" as="geometry"/></mxCell>

        <!-- ===== 两个 broker 的角色 ===== -->
        <mxCell id="brl" value="两边的 broker，对「消息」的态度截然相反 ↓" style="text;html=1;align=left;fontSize=11;fontStyle=1;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="54" y="408" width="500" height="16" as="geometry"/></mxCell>
        <mxCell id="kbroker" value="Kafka broker：对消息内容无感&#10;只把一段字节整体搬走，不拆、不看、不加工&#10;→ 正因为不加工，才用得上 sendfile（整段零拷贝）" style="shape=note;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#FBE6E4;strokeColor=#B85450;size=16;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="54" y="430" width="488" height="78" as="geometry"/></mxCell>
        <mxCell id="rbroker" value="RocketMQ broker：要「看懂」每一条消息&#10;tag 过滤 / 事务按状态投 / 延时掐点投，都得逐条处理&#10;→ 数据要被加工，所以用不了 sendfile，多还一次拷贝" style="shape=note;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#E6EEFB;strokeColor=#6C8EBF;size=16;fontSize=11;align=left;spacingLeft=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="566" y="430" width="490" height="78" as="geometry"/></mxCell>

        <!-- ===== 底部主旨 ===== -->
        <mxCell id="banner" value="说到底是同一个选择：让 broker 当一根只搬字节的「笨管子」（Kafka → 零拷贝、吞吐顶满），还是当一个看得懂每条消息的「服务端」（RocketMQ → 扛起事务 / 延时 / 过滤）。" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#F5F5F5;strokeColor=#666666;fontSize=12;fontStyle=1;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="54" y="522" width="1002" height="48" as="geometry"/></mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
