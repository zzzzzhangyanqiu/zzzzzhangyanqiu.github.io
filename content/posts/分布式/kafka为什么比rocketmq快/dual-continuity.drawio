        <!-- 消费者 -->
        <mxCell id="cons" value="消费者&#10;/ 网卡" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=12;" vertex="1" parent="1"><mxGeometry x="400" y="120" width="78" height="120" as="geometry"/></mxCell>

