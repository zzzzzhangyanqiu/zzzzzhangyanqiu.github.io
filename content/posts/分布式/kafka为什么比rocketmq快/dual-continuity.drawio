        <mxCell id="rcl" value="" style="rounded=1;sketch=1;fillColor=none;strokeColor=#999999;dashed=1;" vertex="1" parent="1"><mxGeometry x="584" y="96" width="460" height="42" as="geometry"/></mxCell>
        <mxCell id="rcll" value="CommitLog（全节点唯一，按写入顺序追加）" style="text;html=1;align=left;fontSize=10;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="588" y="80" width="320" height="14" as="geometry"/></mxCell>

        <mxCell id="c0" value="" style="rounded=0;whiteSpace=wrap;html=1;sketch=1;fillStyle=solid;fillColor=#F8CECC;strokeColor=#B85450;" vertex="1" parent="1"><mxGeometry x="590" y="102" width="48" height="30" as="geometry"/></mxCell>
